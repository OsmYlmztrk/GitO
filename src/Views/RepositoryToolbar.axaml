<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="56"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <!-- Fork-style toolbar button: icon on top, label below -->
    <Style Selector=":is(Button).tool">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="4,5"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector=":is(Button).tool /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector=":is(Button).tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
    </Style>
    <Style Selector=":is(Button).tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.FloatingBorder}"/>
    </Style>
    <Style Selector=":is(Button).tool Path.tool_icon">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector=":is(Button).tool TextBlock.tool_label">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector=":is(Button).tool:pointerover TextBlock.tool_label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
    </Style>
    <Style Selector=":is(Button).tool:disabled Path.tool_icon">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="Rectangle.tool_sep">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.Border2}"/>
    </Style>
    <!-- Ahead/behind dot on Pull/Push -->
    <Style Selector="Ellipse.tool_dot">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Height" Value="7"/>
      <Setter Property="Margin" Value="0,-2,-4,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.FloatingBorder}"/>
    </Style>
    <!-- Smaller variant for less frequent tools -->
    <Style Selector=":is(Button).tool.small">
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="Padding" Value="3,6,3,5"/>
    </Style>
    <Style Selector=":is(Button).tool.small Path.tool_icon">
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Margin" Value="0,1,0,2"/>
    </Style>
    <Style Selector=":is(Button).tool.small TextBlock.tool_label">
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <!-- Tooltips: title, what it does, shortcut -->
    <Style Selector="StackPanel.tip">
      <Setter Property="MaxWidth" Value="300"/>
      <Setter Property="Spacing" Value="4"/>
    </Style>
    <Style Selector="StackPanel.tip TextBlock.tip_title">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="StackPanel.tip TextBlock.tip_desc">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="StackPanel.tip TextBlock.tip_key">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,0,Auto" Margin="8,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <Button Classes="tool" Click="OpenWithExternalTools">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Şurada aç"/>
            <TextBlock Classes="tip_desc" Text="Repo klasörünü Dosya Gezgini, terminal ya da yüklü bir editör / IDE ile açar."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.OpenWith}"/>
          <TextBlock Classes="tool_label" Text="Open in"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <Button Classes="tool" Tapped="Fetch">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Fetch (Getir)"/>
            <TextBlock Classes="tip_desc" Text="Remote'taki yeni commit, branch ve tag'leri indirir. Dosyalarına ve branch'lerine dokunmaz."/>
            <TextBlock Classes="tip_key" Text="Ctrl ile tıklarsan pencere açmadan doğrudan başlar"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Fetch}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Pull (Çek)"/>
            <TextBlock Classes="tip_desc" Text="Takip edilen remote branch'i indirip mevcut branch'e merge (ya da rebase) eder. İkondaki nokta, remote'ta çekilecek yeni commit olduğunu gösterir."/>
            <TextBlock Classes="tip_key" Text="Ctrl ile tıklarsan pencere açmadan doğrudan başlar"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Grid HorizontalAlignment="Center">
            <Path Classes="tool_icon" Data="{StaticResource Icons.Pull}"/>
            <Ellipse Classes="tool_dot" IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Pull}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Push (Gönder)"/>
            <TextBlock Classes="tip_desc" Text="Mevcut branch'teki commit'leri remote'a yükler. İkondaki nokta, henüz gönderilmemiş yerel commit'lerin olduğunu gösterir."/>
            <TextBlock Classes="tip_key" Text="Ctrl ile tıklarsan pencere açmadan doğrudan başlar"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Grid HorizontalAlignment="Center">
            <Path Classes="tool_icon" Data="{StaticResource Icons.Push}"/>
            <Ellipse Classes="tool_dot" IsVisible="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Push}"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <Button Classes="tool" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Yeni branch oluştur"/>
            <TextBlock Classes="tip_desc" Text="Mevcut commit'ten yeni bir branch oluşturur; istersen hemen ona geçer."/>
            <TextBlock Classes="tip_key" Text="{OnPlatform Ctrl+B, macOS=⌘+B}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Classes="tool_label" Text="Branch"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <!-- MyGitGUI: less used tools live in a panel that this toggle shows and hides -->
      <ToggleButton x:Name="MoreToolsToggle" Classes="tool">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Diğer araçlar"/>
            <TextBlock Classes="tip_desc" Text="Stash, Patch, Terminal, LFS, Git-Flow, Bisect, Actions, Cleanup, Logs ve Stats düğmelerini gösterir ya da gizler."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.More}"/>
          <TextBlock Classes="tool_label" Text="More"/>
        </StackPanel>
      </ToggleButton>

      <StackPanel Orientation="Horizontal" IsVisible="{Binding #MoreToolsToggle.IsChecked}">
        <Button Classes="tool" Tapped="StashAll" IsVisible="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Stash (Kenara koy)"/>
              <TextBlock Classes="tip_desc" Text="Commit'lenmemiş değişikliklerini kenara kaydeder ve çalışma alanını temizler. Sonra Stashes'tan geri alabilirsin."/>
              <TextBlock Classes="tip_key" Text="Ctrl ile tıklarsan pencere açmadan doğrudan başlar"/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.Stashes.Add}"/>
            <TextBlock Classes="tool_label" Text="{DynamicResource Text.Stash}"/>
          </StackPanel>
        </Button>

        <Button Classes="tool" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Yama uygula"/>
              <TextBlock Classes="tip_desc" Text="Bir .patch / .diff dosyasını çalışma alanına uygular."/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.ApplyPatch}"/>
            <TextBlock Classes="tool_label" Text="Patch"/>
          </StackPanel>
        </Button>

        <Rectangle Classes="tool_sep"/>

        <Button Classes="tool" Click="OpenTerminal">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Terminalde aç"/>
              <TextBlock Classes="tip_desc" Text="Repo klasöründe bir terminal açar (kabuk Preferences ayarlarından seçilir)."/>
              <TextBlock Classes="tip_key" Text="{OnPlatform Ctrl+`, macOS=⌃+`}"/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.Terminal}"/>
            <TextBlock Classes="tool_label" Text="Terminal"/>
          </StackPanel>
        </Button>

        <Rectangle Classes="tool_sep"/>

        <!-- Less frequent tools: smaller icons, still labeled -->
        <Button Classes="tool small" Click="OpenGitLFSMenu" IsVisible="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Git LFS (büyük dosyalar)"/>
              <TextBlock Classes="tip_desc" Text="Büyük dosyalar: dosya kalıplarını takibe alır, LFS nesnelerini fetch / pull / push eder, yerel önbelleği temizler ve dosya kilitlerini yönetir."/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.LFS}"/>
            <TextBlock Classes="tool_label" Text="LFS"/>
          </StackPanel>
        </Button>

        <Button Classes="tool small" Click="OpenGitFlowMenu" IsVisible="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Git-Flow"/>
              <TextBlock Classes="tip_desc" Text="git-flow iş akışıyla feature, release ve hotfix branch'lerini başlatır ve bitirir."/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.GitFlow}"/>
            <TextBlock Classes="tool_label" Text="Git-Flow"/>
          </StackPanel>
        </Button>

        <Button Classes="tool small" Click="StartBisect" IsVisible="{Binding !IsBare}">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Bisect (hatalı commit'i bul)"/>
              <TextBlock Classes="tip_desc" Text="Hatayı getiren commit'i bulur: commit'leri iyi ya da kötü diye işaretlersin, git aralığı her seferinde ikiye bölerek tek commit kalana kadar daraltır."/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.Bisect}"/>
            <TextBlock Classes="tool_label" Text="Bisect"/>
          </StackPanel>
        </Button>

        <Button Classes="tool small" Click="OpenCustomActionMenu">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Özel komutlar"/>
              <TextBlock Classes="tip_desc" Text="Bu repo için kendi komutlarını ya da script'lerini çalıştırır. Tanımlamak için: Configure this repository › Custom Action."/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.Action}"/>
            <TextBlock Classes="tool_label" Text="Actions"/>
          </StackPanel>
        </Button>

        <Button Classes="tool small" Click="Cleanup">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Temizlik (GC ve Prune)"/>
              <TextBlock Classes="tip_desc" Text="git gc ve prune çalıştırır: repoyu sıkıştırır, artık erişilemeyen nesneleri siler. Büyük repolarda uzun sürebilir."/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.Clean}"/>
            <TextBlock Classes="tool_label" Text="Cleanup"/>
          </StackPanel>
        </Button>

        <Button Classes="tool small" Click="OpenGitLogs">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="Komut kayıtları"/>
              <TextBlock Classes="tip_desc" Text="Uygulamanın bu repoda çalıştırdığı git komutlarını ve çıktılarını gösterir. Bir şey ters gittiğinde işe yarar."/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.Logs}"/>
            <TextBlock Classes="tool_label" Text="Logs"/>
          </StackPanel>
        </Button>

        <Button Classes="tool small" Click="OpenStatistics">
          <ToolTip.Tip>
            <StackPanel Classes="tip">
              <TextBlock Classes="tip_title" Text="İstatistikler"/>
              <TextBlock Classes="tip_desc" Text="Yazara ve zamana göre (hafta, ay, yıl) commit istatistikleri."/>
            </StackPanel>
          </ToolTip.Tip>
          <StackPanel>
            <Path Classes="tool_icon" Data="{StaticResource Icons.Statistics}"/>
            <TextBlock Classes="tool_label" Text="Stats"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
      <!-- MyGitGUI: active git account; shown only when accounts are set up in Preferences -->
      <Button x:Name="AccountButton"
              Height="28" MaxWidth="180"
              Margin="0,0,8,0" Padding="10,0"
              CornerRadius="5"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}"
              IsVisible="False"
              Click="OpenAccountMenu">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Git hesabı"/>
            <TextBlock x:Name="AccountTipDetail" Classes="tip_desc"/>
            <TextBlock Classes="tip_desc" Text="Tıklayınca bu repo için hesap seçersin: commit yazarı (user.name / user.email) ve push / pull girişi değişir."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Width="12" Height="12" Data="{StaticResource Icons.User}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock x:Name="AccountLabel" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Button>

      <!-- Current branch pill -->
      <Button Height="28" MaxWidth="260"
              Padding="10,0"
              CornerRadius="5"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}"
              Click="NavigateToHead"
              ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.Accent}"/>
          <TextBlock Margin="6,0,0,0"
                     FontWeight="SemiBold"
                     Text="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Margin="6,0,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding CurrentBranch?.TrackStatusDescription, Mode=OneWay}"/>
        </StackPanel>
      </Button>

      <!-- Repository settings (moved here from the sidebar) -->
      <Button Width="28" Height="28"
              Margin="8,0,0,0" Padding="0"
              CornerRadius="5"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}"
              Click="OpenRepositoryConfigure">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Repo ayarları"/>
            <TextBlock Classes="tip_desc" Text="Bu repoya özel ayarlar: kullanıcı bilgisi, remote'lar, otomatik fetch, issue tracker, özel komutlar ve commit şablonları."/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="14" Height="14" Data="{StaticResource Icons.Settings}" Fill="{DynamicResource Brush.FG1}"/>
      </Button>

      <!-- Commit search -->
      <Button Width="220" Height="28"
              Margin="8,0,0,0" Padding="8,0"
              CornerRadius="5"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}"
              HorizontalContentAlignment="Stretch"
              Click="OpenCommitSearch"
              ToolTip.Tip="Commit'lerde mesaja, yazara, SHA'ya, dosya yoluna ya da içeriğe göre arama yapar">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Path Grid.Column="0" Width="13" Height="13" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="Search commits" Foreground="{DynamicResource Brush.FG2}"/>
          <TextBlock Grid.Column="2" FontSize="11" Text="{OnPlatform Ctrl+Shift+F, macOS=⌘+Shift+F}" Foreground="{DynamicResource Brush.FG2}"/>
        </Grid>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
