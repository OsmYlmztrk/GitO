<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="56"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <!-- Fork-style toolbar button: icon on top, label below -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinWidth" Value="54"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.FloatingBorder}"/>
    </Style>
    <Style Selector="Button.tool Path.tool_icon">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool TextBlock.tool_label">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool:pointerover TextBlock.tool_label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
    </Style>
    <Style Selector="Button.tool:disabled Path.tool_icon">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="Rectangle.tool_sep">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.Border2}"/>
    </Style>
    <!-- Ahead/behind dot on Pull/Push -->
    <Style Selector="Ellipse.tool_dot">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Height" Value="7"/>
      <Setter Property="Margin" Value="0,-2,-4,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,0,Auto" Margin="8,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <Button Classes="tool" Click="OpenWithExternalTools" ToolTip.Tip="{DynamicResource Text.Repository.OpenWithExternalTools}">
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.OpenWith}"/>
          <TextBlock Classes="tool_label" Text="Open in"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <Button Classes="tool" Tapped="Fetch">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Fetch}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Fetch}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Pull}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Grid HorizontalAlignment="Center">
            <Path Classes="tool_icon" Data="{StaticResource Icons.Pull}"/>
            <Ellipse Classes="tool_dot" IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Pull}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Push}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Grid HorizontalAlignment="Center">
            <Path Classes="tool_icon" Data="{StaticResource Icons.Push}"/>
            <Ellipse Classes="tool_dot" IsVisible="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Push}"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <Button Classes="tool" Tapped="StashAll" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Stash}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Stashes.Add}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Stash}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Apply.Title}">
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.ApplyPatch}"/>
          <TextBlock Classes="tool_label" Text="Patch"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <Button Classes="tool" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <ToolTip.Tip>
          <TextBlock>
            <Run Text="{DynamicResource Text.Repository.NewBranch}"/>
            <Run Text=" "/>
            <Run Text="{OnPlatform Ctrl+B, macOS=⌘+B}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </TextBlock>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Classes="tool_label" Text="Branch"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Click="OpenTerminal" ToolTip.Tip="{DynamicResource Text.Repository.Terminal}">
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Terminal}"/>
          <TextBlock Classes="tool_label" Text="Terminal"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <!-- Less frequent tools: icon only -->
      <Button Classes="icon_button" Width="30" Click="OpenGitLFSMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitLFS}">
        <Path Width="15" Height="15" Data="{StaticResource Icons.LFS}"/>
      </Button>
      <Button Classes="icon_button" Width="30" Click="OpenGitFlowMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitFlow}">
        <Path Width="15" Height="15" Data="{StaticResource Icons.GitFlow}"/>
      </Button>
      <Button Classes="icon_button" Width="30" Click="StartBisect" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Bisect}">
        <Path Width="15" Height="15" Data="{StaticResource Icons.Bisect}"/>
      </Button>
      <Button Classes="icon_button" Width="30" Click="OpenCustomActionMenu" ToolTip.Tip="{DynamicResource Text.Repository.CustomActions}">
        <Path Width="15" Height="15" Data="{StaticResource Icons.Action}"/>
      </Button>
      <Button Classes="icon_button" Width="30" Click="Cleanup" ToolTip.Tip="{DynamicResource Text.Repository.Clean}">
        <Path Width="15" Height="15" Data="{StaticResource Icons.Clean}"/>
      </Button>
      <Button Classes="icon_button" Width="30" Click="OpenGitLogs" ToolTip.Tip="{DynamicResource Text.Repository.ViewLogs}">
        <Path Width="15" Height="15" Data="{StaticResource Icons.Logs}"/>
      </Button>
      <Button Classes="icon_button" Width="30" Click="OpenStatistics" ToolTip.Tip="{DynamicResource Text.Repository.Statistics}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Statistics}"/>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
      <!-- Current branch pill -->
      <Button Height="28" MaxWidth="260"
              Padding="10,0"
              CornerRadius="5"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}"
              Click="NavigateToHead"
              ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.Accent}"/>
          <TextBlock Margin="6,0,0,0"
                     FontWeight="SemiBold"
                     Text="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Margin="6,0,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding CurrentBranch?.TrackStatusDescription, Mode=OneWay}"/>
        </StackPanel>
      </Button>

      <!-- Commit search -->
      <Button Width="220" Height="28"
              Margin="8,0,0,0" Padding="8,0"
              CornerRadius="5"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}"
              HorizontalContentAlignment="Stretch"
              Click="OpenCommitSearch">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Path Grid.Column="0" Width="13" Height="13" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="Search commits" Foreground="{DynamicResource Brush.FG2}"/>
          <TextBlock Grid.Column="2" FontSize="11" Text="{OnPlatform Ctrl+Shift+F, macOS=⌘+Shift+F}" Foreground="{DynamicResource Brush.FG2}"/>
        </Grid>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
