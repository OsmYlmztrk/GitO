<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="56"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Styles>
    <!-- Fork-style toolbar button: icon on top, label below -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinWidth" Value="54"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.BackgroundHovered}"/>
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FlatButton.FloatingBorder}"/>
    </Style>
    <Style Selector="Button.tool Path.tool_icon">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.FG1}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool TextBlock.tool_label">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tool:pointerover TextBlock.tool_label">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
    </Style>
    <Style Selector="Button.tool:disabled Path.tool_icon">
      <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="Rectangle.tool_sep">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.Border2}"/>
    </Style>
    <!-- Ahead/behind dot on Pull/Push -->
    <Style Selector="Ellipse.tool_dot">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Height" Value="7"/>
      <Setter Property="Margin" Value="0,-2,-4,0"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <!-- Smaller variant for less frequent tools -->
    <Style Selector="Button.tool.small">
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="Padding" Value="5,6,5,5"/>
    </Style>
    <Style Selector="Button.tool.small Path.tool_icon">
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Margin" Value="0,1,0,2"/>
    </Style>
    <Style Selector="Button.tool.small TextBlock.tool_label">
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <!-- Tooltips: title, what it does, shortcut -->
    <Style Selector="StackPanel.tip">
      <Setter Property="MaxWidth" Value="300"/>
      <Setter Property="Spacing" Value="4"/>
    </Style>
    <Style Selector="StackPanel.tip TextBlock.tip_title">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="StackPanel.tip TextBlock.tip_desc">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="StackPanel.tip TextBlock.tip_key">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,0,Auto" Margin="8,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <Button Classes="tool" Click="OpenWithExternalTools">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="Open in"/>
            <TextBlock Classes="tip_desc" Text="Open the repository folder in File Explorer, a terminal, or an installed editor / IDE."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.OpenWith}"/>
          <TextBlock Classes="tool_label" Text="Open in"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <Button Classes="tool" Tapped="Fetch">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Fetch}"/>
            <TextBlock Classes="tip_desc" Text="Download new commits, branches and tags from the remote. Your files and branches are not changed."/>
            <TextBlock Classes="tip_key" Text="{DynamicResource Text.CtrlClickTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Fetch}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Pull}"/>
            <TextBlock Classes="tip_desc" Text="Fetch the upstream branch and merge (or rebase) it into the current branch. A dot on the icon means the remote has new commits."/>
            <TextBlock Classes="tip_key" Text="{DynamicResource Text.CtrlClickTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Grid HorizontalAlignment="Center">
            <Path Classes="tool_icon" Data="{StaticResource Icons.Pull}"/>
            <Ellipse Classes="tool_dot" IsVisible="{Binding CurrentBranch?.Behind, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Pull}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Push}"/>
            <TextBlock Classes="tip_desc" Text="Upload the commits of the current branch to the remote. A dot on the icon means you have local commits that are not pushed yet."/>
            <TextBlock Classes="tip_key" Text="{DynamicResource Text.CtrlClickTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Grid HorizontalAlignment="Center">
            <Path Classes="tool_icon" Data="{StaticResource Icons.Push}"/>
            <Ellipse Classes="tool_dot" IsVisible="{Binding CurrentBranch?.Ahead, Mode=OneWay, Converter={x:Static c:ListConverters.IsNotNullOrEmpty}}"/>
          </Grid>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Push}"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <Button Classes="tool" Tapped="StashAll" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Stash}"/>
            <TextBlock Classes="tip_desc" Text="Put your uncommitted changes aside and clean the working copy. Bring them back later from Stashes."/>
            <TextBlock Classes="tip_key" Text="{DynamicResource Text.CtrlClickTip}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Stashes.Add}"/>
          <TextBlock Classes="tool_label" Text="{DynamicResource Text.Stash}"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Apply.Title}"/>
            <TextBlock Classes="tip_desc" Text="Apply a .patch / .diff file to the working copy."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.ApplyPatch}"/>
          <TextBlock Classes="tool_label" Text="Patch"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <Button Classes="tool" Command="{Binding CreateNewBranch}" HotKey="{OnPlatform Ctrl+B, macOS=⌘+B}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Repository.NewBranch}"/>
            <TextBlock Classes="tip_desc" Text="Create a new branch from the current commit, optionally switching to it."/>
            <TextBlock Classes="tip_key" Text="{OnPlatform Ctrl+B, macOS=⌘+B}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Branch.Add}"/>
          <TextBlock Classes="tool_label" Text="Branch"/>
        </StackPanel>
      </Button>

      <Button Classes="tool" Click="OpenTerminal">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Repository.Terminal}"/>
            <TextBlock Classes="tip_desc" Text="Open a terminal in the repository folder (set the shell in Preferences)."/>
            <TextBlock Classes="tip_key" Text="{OnPlatform Ctrl+`, macOS=⌃+`}"/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Terminal}"/>
          <TextBlock Classes="tool_label" Text="Terminal"/>
        </StackPanel>
      </Button>

      <Rectangle Classes="tool_sep"/>

      <!-- Less frequent tools: smaller icons, still labeled -->
      <Button Classes="tool small" Click="OpenGitLFSMenu" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.GitLFS}"/>
            <TextBlock Classes="tip_desc" Text="Large files: track file patterns, fetch / pull / push LFS objects, prune the local cache and manage file locks."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.LFS}"/>
          <TextBlock Classes="tool_label" Text="LFS"/>
        </StackPanel>
      </Button>

      <Button Classes="tool small" Click="OpenGitFlowMenu" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.GitFlow}"/>
            <TextBlock Classes="tip_desc" Text="Start and finish feature, release and hotfix branches with the git-flow workflow."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.GitFlow}"/>
          <TextBlock Classes="tool_label" Text="Git-Flow"/>
        </StackPanel>
      </Button>

      <Button Classes="tool small" Click="StartBisect" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Bisect}"/>
            <TextBlock Classes="tip_desc" Text="Find the commit that introduced a bug: mark commits as good or bad and git halves the range until one commit is left."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Bisect}"/>
          <TextBlock Classes="tool_label" Text="Bisect"/>
        </StackPanel>
      </Button>

      <Button Classes="tool small" Click="OpenCustomActionMenu">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Repository.CustomActions}"/>
            <TextBlock Classes="tip_desc" Text="Run your own commands or scripts for this repository. Define them in Configure this repository › Custom Action."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Action}"/>
          <TextBlock Classes="tool_label" Text="Actions"/>
        </StackPanel>
      </Button>

      <Button Classes="tool small" Click="Cleanup">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Repository.Clean}"/>
            <TextBlock Classes="tip_desc" Text="Run git gc and prune: compress the repository and remove unreachable objects. Can take a while on large repositories."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Clean}"/>
          <TextBlock Classes="tool_label" Text="Cleanup"/>
        </StackPanel>
      </Button>

      <Button Classes="tool small" Click="OpenGitLogs">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Repository.ViewLogs}"/>
            <TextBlock Classes="tip_desc" Text="Show the git commands this app has run in this repository and their output. Useful when something fails."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Logs}"/>
          <TextBlock Classes="tool_label" Text="Logs"/>
        </StackPanel>
      </Button>

      <Button Classes="tool small" Click="OpenStatistics">
        <ToolTip.Tip>
          <StackPanel Classes="tip">
            <TextBlock Classes="tip_title" Text="{DynamicResource Text.Repository.Statistics}"/>
            <TextBlock Classes="tip_desc" Text="Commit activity by author and over time (week, month, year)."/>
          </StackPanel>
        </ToolTip.Tip>
        <StackPanel>
          <Path Classes="tool_icon" Data="{StaticResource Icons.Statistics}"/>
          <TextBlock Classes="tool_label" Text="Stats"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
      <!-- Current branch pill -->
      <Button Height="28" MaxWidth="260"
              Padding="10,0"
              CornerRadius="5"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}"
              Click="NavigateToHead"
              ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Width="13" Height="13" Data="{StaticResource Icons.Branch}" Fill="{DynamicResource Brush.Accent}"/>
          <TextBlock Margin="6,0,0,0"
                     FontWeight="SemiBold"
                     Text="{Binding CurrentBranch?.Name, TargetNullValue='--', Mode=OneWay}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock Margin="6,0,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{Binding CurrentBranch?.TrackStatusDescription, Mode=OneWay}"/>
        </StackPanel>
      </Button>

      <!-- Commit search -->
      <Button Width="220" Height="28"
              Margin="8,0,0,0" Padding="8,0"
              CornerRadius="5"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}"
              HorizontalContentAlignment="Stretch"
              Click="OpenCommitSearch"
              ToolTip.Tip="Search commits by message, author, SHA, file path or content">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Path Grid.Column="0" Width="13" Height="13" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="Search commits" Foreground="{DynamicResource Brush.FG2}"/>
          <TextBlock Grid.Column="2" FontSize="11" Text="{OnPlatform Ctrl+Shift+F, macOS=⌘+Shift+F}" Foreground="{DynamicResource Brush.FG2}"/>
        </Grid>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
