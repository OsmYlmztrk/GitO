<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SourceGit.Views.Conflict"
             x:DataType="vm:Conflict">
  <UserControl.Styles>
    <!-- MyGitGUI: Fork-style conflict panel -->
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="12"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Window}"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.side_title">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- MyGitGUI: Unreal card -->
    <Style Selector="TextBlock.how">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="Border.status">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
    </Style>
    <Style Selector="Border.status.error">
      <Setter Property="BorderBrush" Value="#80E5484D"/>
      <Setter Property="Background" Value="#1FE5484D"/>
    </Style>
    <Style Selector="Border.side_tag">
      <Setter Property="Height" Value="18"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="#FF6B6B80"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="Border.side_tag.ours">
      <Setter Property="Background" Value="#FF2F7BF5"/>
    </Style>
    <Style Selector="Border.side_tag.theirs">
      <Setter Property="Background" Value="#FFF2994A"/>
    </Style>
    <Style Selector="Border.side_tag.conflict">
      <Setter Property="Background" Value="#FFE5484D"/>
    </Style>
    <Style Selector="Border.side_tag TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.kv_key">
      <Setter Property="Width" Value="56"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.take">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.take:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <!-- MyGitGUI: the hints on this panel are sentences; wrap them instead of one long line -->
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="380"/>
    </Style>
    <Style Selector="ToolTip /template/ ContentPresenter">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="m:Commit">
      <StackPanel Orientation="Vertical" Spacing="6">
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="kv_key" Text="Commit"/>
          <TextBlock Text="{Binding SHA, Converter={x:Static c:StringConverters.ToShortSHA}}"
                     FontFamily="{DynamicResource Fonts.Monospace}"
                     Foreground="{DynamicResource Brush.Link}"
                     TextDecorations="Underline"
                     Cursor="Hand"
                     VerticalAlignment="Center"
                     PointerPressed="OnPressedSHA"/>
          <v:CommitRefsPresenter Margin="6,0,0,0"
                                 Foreground="{DynamicResource Brush.FG1}"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 UseGraphColor="False"/>
        </StackPanel>
        <Grid ColumnDefinitions="56,*">
          <TextBlock Grid.Column="0" Classes="kv_key" Text="Subject"/>
          <TextBlock Grid.Column="1" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="kv_key" Text="Author"/>
          <v:Avatar Width="16" Height="16" VerticalAlignment="Center" User="{Binding Author}"/>
          <TextBlock Margin="6,0,0,0" Text="{Binding Author.Name}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="kv_key" Text="Date"/>
          <v:DateTimePresenter Timestamp="{Binding AuthorTime}" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="x:String">
      <StackPanel Orientation="Horizontal">
        <Path Width="12" Height="12" Data="{StaticResource Icons.Changes}"/>
        <TextBlock Margin="6,0,0,0" Text="{Binding}"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Border Background="{DynamicResource Brush.Contents}" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}" CornerRadius="4" ClipToBounds="True">
    <Grid RowDefinitions="40,*">
      <!-- Header -->
      <Border Grid.Row="0" Padding="12,0" Background="{DynamicResource Brush.SubPanel}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
          <Path Grid.Column="0" Width="13" Height="13" Data="{StaticResource Icons.File}" Fill="{DynamicResource Brush.FG2}"/>
          <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding FilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Actor, Converter={x:Static ObjectConverters.IsNull}}"/>
          <!-- MyGitGUI: actor name and class instead of the hashed file name; the real path is in the tooltip -->
          <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding FilePath}"
                     IsVisible="{Binding Actor, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Run Text="{Binding Actor.Label}" FontWeight="SemiBold"/>
            <Run Text="{Binding Actor.Detail}" Foreground="{DynamicResource Brush.FG2}"/>
          </TextBlock>

          <Border Grid.Column="2" Classes="chip" Background="#18888888" BorderBrush="{DynamicResource Brush.Border1}" IsVisible="{Binding IsBinary}">
            <TextBlock Text="Binary" Foreground="{DynamicResource Brush.FG2}"/>
          </Border>
          <Border Grid.Column="3" Classes="chip" Background="#28B77EE0" BorderBrush="#A0B77EE0" IsVisible="{Binding IsLFS}">
            <TextBlock Text="LFS" Foreground="#FFB77EE0"/>
          </Border>
          <Border Grid.Column="5" Classes="chip" Background="#28E5534B" BorderBrush="#A0E5534B">
            <TextBlock Foreground="#FFF08A84">
              <Run Text="{Binding Marker}" FontWeight="Bold"/>
              <Run Text="{Binding Description}"/>
            </TextBlock>
          </Border>
        </Grid>
      </Border>

      <!-- Unresolved -->
      <ScrollViewer Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding State, Mode=OneWay, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:ConflictFileState.Resolved}}">
        <StackPanel Orientation="Vertical" Margin="20,16" Spacing="14" MaxWidth="980">
          <!-- Explanation -->
          <Grid ColumnDefinitions="Auto,*">
            <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" Data="{StaticResource Icons.Error}" Fill="#FFD19A3A"/>
            <!-- MyGitGUI: text depends on the conflict kind (deleted on one side, both changed, ...) -->
            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding Explanation}"/>
          </Grid>

          <!-- Ours / Theirs (MyGitGUI: not for level actors; those are merged in Unreal only) -->
          <UniformGrid Columns="2" ColumnSpacing="14" IsVisible="{Binding !IsLevelActor}">
            <Border Classes="card" BorderBrush="#734C9AFF">
              <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Classes="side_title" Text="OURS" Foreground="{DynamicResource Brush.Accent}"/>
                  <Path Width="12" Height="12" Margin="8,0,0,0" Data="{StaticResource Icons.Local}" Fill="{DynamicResource Brush.Accent}"/>
                </StackPanel>
                <ContentControl Content="{Binding Mine}"/>
                <Button Classes="take" Background="{DynamicResource Brush.Accent}" Click="OnUseMine">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.Check}" Fill="White"/>
                    <TextBlock Text="Take Ours" FontWeight="SemiBold" Foreground="White"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Border Classes="card" BorderBrush="#73F0A33A">
              <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <TextBlock Classes="side_title" Text="THEIRS" Foreground="#FFF0A33A"/>
                  <Path Width="12" Height="12" Margin="8,0,0,0" Data="{StaticResource Icons.Incoming}" Fill="#FFF0A33A"/>
                </StackPanel>
                <ContentControl Content="{Binding Theirs}"/>
                <Button Classes="take" Background="#FFF0A33A" Click="OnUseTheirs">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.Check}" Fill="#FF1C1C1E"/>
                    <TextBlock Text="Take Theirs" FontWeight="SemiBold" Foreground="#FF1C1C1E"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- MyGitGUI: level that can't be merged because it isn't One File Per Actor on both sides -->
          <Border Classes="status" BorderBrush="#80F5A524" Background="#1FF5A524"
                  IsVisible="{Binding LevelNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                    Data="{StaticResource Icons.Error}" Fill="#FFF5A524"/>
              <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Vertical" Spacing="6">
                <TextBlock Text="This level can't be merged change by change" FontWeight="SemiBold"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}" Text="{Binding LevelNotice}"/>
                <Button Classes="flat" Height="28" Padding="10,0" HorizontalAlignment="Left" Click="OnOpenLevelGuide"
                        ToolTip.Tip="Opens the GitO guide on GitHub">
                  <TextBlock Text="How to turn on One File Per Actor"/>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- MyGitGUI: actor of a One File Per Actor level: all its conflicted actors are merged together in Unreal -->
          <Border Classes="card" IsVisible="{Binding IsLevelActor}">
            <StackPanel Orientation="Vertical" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Width="14" Height="14" Data="{StaticResource Icons.Diff}"/>
                <TextBlock FontWeight="SemiBold">
                  <Run Text="Level"/>
                  <Run Text="{Binding Actor.Level}"/>
                </TextBlock>
                <Border Classes="chip" BorderBrush="{DynamicResource Brush.Border2}">
                  <TextBlock>
                    <Run Text="{Binding LevelActors.Count, Mode=OneWay}"/>
                    <Run Text="actor(s)"/>
                  </TextBlock>
                </Border>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding LevelActors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="m:Change">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                      <TextBlock Text="{Binding ConflictMarker}" Foreground="DarkOrange" FontWeight="Bold"/>
                      <TextBlock Text="{Binding DisplayFileName}"/>
                      <TextBlock Text="{Binding UnrealActor.ClassName}" Foreground="{DynamicResource Brush.FG2}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="how" Text="Merged together in Unreal. You decide every change."/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Width="12" Height="12" Data="{StaticResource Icons.Error}" Fill="#FF9800"/>
                <TextBlock Classes="how" Text="Save your work and close Unreal first."/>
              </StackPanel>
              <TextBlock Classes="how" IsVisible="{Binding !HasMergePlugin}"
                         Text="Needs the GitBlueprintMerge plugin (Unreal 5.8)."/>

              <Button Classes="flat primary" Height="28" Padding="10,0" HorizontalAlignment="Left"
                      Click="OnResolveLevelInUnreal" IsEnabled="{Binding CanResolveLevel}"
                      ToolTip.Tip="Opens the level in Unreal with every conflicted actor of it">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Width="12" Height="12" Data="{StaticResource Icons.Merge}" Fill="White"/>
                  <TextBlock Text="Resolve level in Unreal" Foreground="White"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- Unreal Editor -->
          <Border Classes="card" IsVisible="{Binding ShowUnrealCard}">
            <StackPanel Orientation="Vertical" Spacing="8">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Path Grid.Column="0" Width="14" Height="14" Data="{StaticResource Icons.Diff}"/>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="Unreal Editor" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasMergePlugin}">
                  <Border Classes="chip"
                          BorderBrush="{DynamicResource Brush.Border2}"
                          ToolTip.Tip="The GitBlueprintMerge plugin is installed for this project's Unreal version.">
                    <TextBlock Text="Asset merge"/>
                  </Border>

                  <!-- Which asset types the plugin merges, so a fallback to Unreal's window is not a surprise -->
                  <Button Classes="icon_button" Margin="4,0,0,0" VerticalAlignment="Center"
                          ToolTip.Tip="Which asset types can be merged">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <Border Width="560" Padding="4">
                          <Border.Resources>
                            <!-- MyGitGUI: what needs the user's attention after a merge -->
                            <SolidColorBrush x:Key="Brush.MergeWarn" Color="#FFF26D6D"/>
                          </Border.Resources>
                          <Border.Styles>
                            <Style Selector="TextBlock.how">
                              <Setter Property="FontSize" Value="11"/>
                              <Setter Property="TextWrapping" Value="Wrap"/>
                              <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
                            </Style>
                            <Style Selector="TextBlock.support_head">
                              <Setter Property="FontSize" Value="11"/>
                              <Setter Property="FontWeight" Value="SemiBold"/>
                              <Setter Property="Margin" Value="0,4,0,0"/>
                            </Style>
                            <Style Selector="TextBlock.support_kind">
                              <Setter Property="FontSize" Value="11"/>
                              <Setter Property="FontWeight" Value="Medium"/>
                              <Setter Property="Margin" Value="0,0,12,2"/>
                            </Style>
                          </Border.Styles>
                          <StackPanel Orientation="Vertical" Spacing="6">
                            <TextBlock Text="What Merge in Unreal can combine" FontWeight="SemiBold"/>

                            <TextBlock Classes="support_head" Text="Merged change by change"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                              <TextBlock Grid.Row="0" Grid.Column="0" Classes="support_kind" Text="Blueprint"/>
                              <TextBlock Grid.Row="0" Grid.Column="1" Classes="how" Text="Nodes and their settings (AnimGraph too), connections, variables, function graphs, class defaults, Class Settings, settings of existing components; Widget Blueprint: widget and slot settings, new widgets"/>
                              <TextBlock Grid.Row="1" Grid.Column="0" Classes="support_kind" Text="Data Asset"/>
                              <TextBlock Grid.Row="1" Grid.Column="1" Classes="how" Text="Every property; fields of a struct one by one"/>
                              <TextBlock Grid.Row="2" Grid.Column="0" Classes="support_kind" Text="Data Table"/>
                              <TextBlock Grid.Row="2" Grid.Column="1" Classes="how" Text="Added and removed rows, every field of a row"/>
                              <TextBlock Grid.Row="3" Grid.Column="0" Classes="support_kind" Text="Material Instance"/>
                              <TextBlock Grid.Row="3" Grid.Column="1" Classes="how" Text="Parameter overrides, static switches, parent, base property overrides"/>
                            </Grid>

                            <TextBlock Classes="support_head" Foreground="{StaticResource Brush.MergeWarn}" Text="Listed for you to redo by hand"/>
                            <TextBlock Classes="how"><Run Text="•  "/><Run Foreground="{StaticResource Brush.MergeWarn}" Text="Blueprint:"/><Run Text=" added or removed event graphs and macros, added / removed / moved components, interfaces, parent class"/></TextBlock>
                            <TextBlock Classes="how"><Run Text="•  "/><Run Foreground="{StaticResource Brush.MergeWarn}" Text="Widget Blueprint designer:"/><Run Text=" removed or moved widgets, widget animations, function bindings"/></TextBlock>
                            <TextBlock Classes="how"><Run Text="•  "/><Run Foreground="{StaticResource Brush.MergeWarn}" Text="Anim Blueprint:"/><Run Text=" new state machines and states (graphs inside nodes)"/></TextBlock>
                            <TextBlock Classes="how"><Run Text="•  Arrays, maps and sets count as one value; "/><Run Foreground="{StaticResource Brush.MergeWarn}" Text="instanced subobjects, material layers and the row structure of a table are not merged"/></TextBlock>

                            <TextBlock Classes="support_head" Foreground="{StaticResource Brush.MergeWarn}" Text="Not checked at all: compare these by hand after merging"/>
                            <TextBlock Classes="how" Foreground="{StaticResource Brush.MergeWarn}" Text="Blueprint timelines and their curves, changes to inherited components, local variables of functions. Theirs' edits there are lost without a warning."/>

                            <TextBlock Classes="support_head" Text="Not supported: Unreal's merge window opens (keep one side)"/>
                            <TextBlock Classes="how"><Run Text="Materials, levels (.umap), Behavior Trees, Sound Cues, Niagara, Sequences, meshes, textures and other asset types. "/><Run Foreground="{StaticResource Brush.MergeWarn}" Text="The side you don't keep is lost."/></TextBlock>
                          </StackPanel>
                        </Border>
                      </Flyout>
                    </Button.Flyout>
                    <Path Width="12" Height="12" Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.FG2}"/>
                  </Button>
                </StackPanel>
                <v:LoadingIcon Grid.Column="3" Width="14" Height="14" IsVisible="{Binding IsUnrealBusy}"/>
              </Grid>

              <!-- What Merge does, so pressing it is not a leap of faith -->
              <StackPanel Orientation="Vertical" Spacing="2" IsVisible="{Binding HasMergePlugin}">
                <TextBlock Classes="how" Text="Merge in Unreal combines both branches for you:"/>
                <TextBlock Classes="how" Text="1.  Unreal merges the asset in the background, change by change."/>
                <TextBlock Classes="how" Text="2.  A window opens in Unreal with every change, so you can check them; for each conflict you keep ours or take theirs."/>
                <TextBlock Classes="how" Text="3.  When you press Merge there, the result is saved and staged. Each step is shown while it runs."/>
              </StackPanel>
              <TextBlock Classes="how"
                         IsVisible="{Binding !HasMergePlugin}"
                         Text="Compare shows Ours and Theirs side by side in Unreal. Merge opens Unreal's merge window, which can only keep one side. GitO ships the GitBlueprintMerge plugin, which merges Blueprints, Data Assets, Data Tables and Material Instances change by change, but only for Unreal 5.8; it isn't available for this project's engine."/>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="flat" Height="28" Padding="10,0" Click="OnCompareInUnreal" IsEnabled="{Binding CanOpenInUnreal}"
                        ToolTip.Tip="Open Unreal's diff with Ours on the left and Theirs on the right">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.Compare}"/>
                    <TextBlock Text="Compare in Unreal"/>
                  </StackPanel>
                </Button>
                <Button Classes="flat primary" Height="28" Padding="10,0" Click="OnMergeInUnreal" IsEnabled="{Binding CanMergeInUnreal}"
                        ToolTip.Tip="Merge both branches; you only decide the conflicts">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.Merge}" Fill="White"/>
                    <TextBlock Text="Merge in Unreal" Foreground="White"/>
                  </StackPanel>
                </Button>
                <Button Classes="flat primary" Height="28" Padding="10,0" Click="OnResolveInUnreal"
                        IsVisible="{Binding CanResolveInUnreal}" IsEnabled="{Binding CanMergeInUnreal}"
                        ToolTip.Tip="Open the merge window in Unreal to decide the conflicts">
                  <TextBlock Text="Resolve in Unreal" Foreground="White"/>
                </Button>
                <Button Classes="flat" Height="28" Padding="10,0" Click="OnOpenUnrealMergeTool"
                        IsVisible="{Binding CanOpenUnrealMergeTool}" IsEnabled="{Binding CanMergeInUnreal}"
                        ToolTip.Tip="Unreal's own merge window: keeps one side of the whole asset">
                  <TextBlock Text="Unreal's merge window"/>
                </Button>
              </StackPanel>

              <!-- Result of the last run -->
              <Border Classes="status"
                      Classes.error="{Binding IsUnrealStatusError}"
                      IsVisible="{Binding UnrealStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*">
                  <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                        Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.Accent}"
                        IsVisible="{Binding !IsUnrealStatusError}"/>
                  <Path Grid.Column="0" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                        Data="{StaticResource Icons.Error}" Fill="#FFE5484D"
                        IsVisible="{Binding IsUnrealStatusError}"/>
                  <SelectableTextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap" Text="{Binding UnrealStatus}"/>
                </Grid>
              </Border>

              <ItemsControl ItemsSource="{Binding UnrealMergeChanges}"
                            IsVisible="{Binding UnrealMergeChanges, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="m:BlueprintMergeChange">
                    <Grid ColumnDefinitions="72,*" Margin="0,2">
                      <Border Grid.Column="0"
                              Classes="side_tag"
                              Classes.ours="{Binding IsOurs}"
                              Classes.theirs="{Binding IsTheirs}"
                              Classes.conflict="{Binding IsConflict}">
                        <TextBlock Text="{Binding Tag}"/>
                      </Border>
                      <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Text}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Merge -->
          <Border Classes="card" IsVisible="{Binding !IsLevelActor}">
            <StackPanel Orientation="Vertical" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Width="14" Height="14" Data="{StaticResource Icons.Conflict}"/>
                <TextBlock Text="Merge" FontWeight="SemiBold"/>
                <Border Background="Transparent" VerticalAlignment="Center" Margin="2,0,0,0" ToolTip.ShowDelay="0"
                        ToolTip.Tip="Ways to combine both versions yourself. Text files: the built-in editor shows both sides; you pick each changed block. Binary files (assets): only an outside program can do it, e.g. a diff/merge tool set in Preferences. For Unreal assets use Merge in Unreal above instead.">
                  <Path Width="12" Height="12" Data="{StaticResource Icons.Info}" Fill="{DynamicResource Brush.FG2}"/>
                </Border>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.FG2}"
                         Text="Pick changes from Ours and Theirs chunk by chunk in the built-in 3-way editor."
                         IsVisible="{Binding !IsBinary}"/>
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.FG2}"
                         Text="Opens the merge tool configured in Preferences › Diff/Merge Tool with Base, Ours and Theirs. Resolve there, then stage the file."
                         IsVisible="{Binding IsBinary}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="flat primary" Height="28" Padding="10,0" Click="OnMerge"
                        IsVisible="{Binding State, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:ConflictFileState.UnmergedText}}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.Conflict}" Fill="White"/>
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Conflicts.Merge}" Foreground="White"/>
                  </StackPanel>
                </Button>
                <Button Classes="flat" Height="28" Padding="10,0" Click="OnMergeExternal"
                        ToolTip.Tip="Opens the diff/merge tool from Preferences with three files: Base (before both changes), Ours and Theirs. Save the result there, then stage the file here."
                        IsVisible="{Binding CanUseExternalMergeTool}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Width="12" Height="12" Data="{StaticResource Icons.OpenWith}"/>
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Conflicts.MergeExternal}"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>


        </StackPanel>
      </ScrollViewer>

      <!-- Resolved -->
      <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center"
                  IsVisible="{Binding State, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static m:ConflictFileState.Resolved}}">
        <Path Width="64" Height="64" Data="{StaticResource Icons.Check}" Fill="Green"/>
        <TextBlock Margin="0,16,0,8" FontSize="20" FontWeight="Bold" Text="{DynamicResource Text.WorkingCopy.Conflicts.Resolved}" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource Text.WorkingCopy.CanStageTip}" Foreground="{DynamicResource Brush.FG2}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
