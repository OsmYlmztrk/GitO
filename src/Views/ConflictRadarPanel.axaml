<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="560"
             x:Class="SourceGit.Views.ConflictRadarPanel"
             x:DataType="vm:ConflictRadar"
             Width="540">
  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="3,1,1,1"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Window}"/>
      <Setter Property="BorderBrush" Value="#FFF0A33A"/>
    </Style>
    <Style Selector="Border.row.high">
      <Setter Property="BorderBrush" Value="#FFE5534B"/>
    </Style>
    <Style Selector="Border.row.low">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}"/>
    </Style>
    <Style Selector="Border.row.reminder">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Border.row.closed">
      <Setter Property="Opacity" Value="0.75"/>
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="#22888888"/>
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="MinHeight" Value="28"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="4">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
      <Path Grid.Column="0" Width="14" Height="14" Data="{StaticResource Icons.Conflict}" Fill="#FFF0A33A"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Çakışma Radarı" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock Text="{Binding SnoozeText}" FontSize="11" Foreground="#FFE0B868" VerticalAlignment="Center" IsVisible="{Binding IsSnoozed}"/>
      </StackPanel>
      <v:LoadingIcon Grid.Column="2" Width="14" Height="14" Margin="0,0,8,0" IsVisible="{Binding IsScanning}"/>
      <Button Grid.Column="3" Classes="flat small" Margin="0,0,6,0" Content="Sessize al ▾" Click="OnOpenSnoozeMenu"/>
      <Button Grid.Column="4" Classes="flat small" Content="Yeniden tara" Click="OnRescan"/>
    </Grid>

    <!-- Settings -->
    <Border Grid.Row="1" Padding="10,6" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource Brush.SubPanel}">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <CheckBox Content="Açık" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
          <CheckBox Content="Sesli uyarı" IsChecked="{Binding IsSoundEnabled, Mode=TwoWay}"/>
          <CheckBox IsChecked="{Binding IsAutoFetchEnabled, Mode=TwoWay}">
            <TextBlock>
              <Run Text="Otomatik fetch ("/><Run Text="{Binding AutoFetchInterval}"/><Run Text=" dk)"/>
            </TextBlock>
          </CheckBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Son" VerticalAlignment="Center"/>
          <NumericUpDown Width="48" Height="28" Minimum="1" Maximum="90" Increment="1" FormatString="0" ShowButtonSpinner="False"
                         Padding="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}"
                         Value="{Binding ActiveDays, Mode=TwoWay}"/>
          <TextBlock Text="günde commit almış remote branch'leri izle" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Classes="dim" Foreground="#FFE0B868" IsVisible="{Binding !IsAutoFetchEnabled}"
                   Text="Otomatik fetch kapalı: radar ekibin yeni push'larını ancak sen Fetch'e bastığında görür."/>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="2" Padding="0,6,0,0">
      <!-- Current risks -->
      <TabItem>
        <TabItem.Header>
          <TextBlock Classes="tab_header">
            <Run Text="Riskler ("/><Run Text="{Binding Count}"/><Run Text=")"/>
          </TextBlock>
        </TabItem.Header>
        <Grid>
          <TextBlock Classes="dim" Margin="2,4" IsVisible="{Binding !HasRisks}">
            <Run Text="Şu an çakışma riski yok. Değiştirdiğin dosyalar, son"/>
            <Run Text="{Binding ActiveDays}"/>
            <Run Text="günde commit almış remote branch'lerle ve LFS kilitleriyle karşılaştırılıyor."/>
          </TextBlock>
          <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasRisks}">
            <ItemsControl ItemsSource="{Binding Risks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="m:ConflictRisk">
                  <Border Classes="row" Classes.high="{Binding IsHigh}" Classes.low="{Binding IsLow}" Classes.reminder="{Binding IsReminder}">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding FileName}" FontWeight="SemiBold"/>
                          <Run Text="  "/>
                          <Run Text="{Binding Folder}" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
                        </TextBlock>
                        <Border Grid.Column="1" Classes="chip"><TextBlock Text="{Binding LevelText}"/></Border>
                      </Grid>
                      <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG2}"/>
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                      <TextBlock Classes="dim" Text="{Binding YourSide}" IsVisible="{Binding !IsReminder}"/>
                      <TextBlock Classes="dim" Text="{Binding Advice}"/>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Button Classes="flat small" Content="Commit'e git" Click="OnGoToCommit" IsVisible="{Binding CanGoToCommit}"/>
                        <Button Classes="flat primary small" Content="Dosyayı kilitle" Click="OnLock" IsVisible="{Binding CanLock}"/>
                        <Button Classes="flat small" Content="Yoksay ▾" Click="OnOpenIgnoreMenu"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- Notification history -->
      <TabItem>
        <TabItem.Header>
          <TextBlock Classes="tab_header" Text="Bildirimler"/>
        </TabItem.Header>
        <Grid RowDefinitions="*,Auto">
          <TextBlock Grid.Row="0" Classes="dim" Margin="2,4" IsVisible="{Binding !HasHistory}"
                     Text="Henüz bildirim yok. Gelen her uyarı — kapattıkların ve yoksaydıkların dahil — burada saklanır."/>
          <ScrollViewer Grid.Row="0" MaxHeight="380" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasHistory}">
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="m:ConflictNotificationRecord">
                  <Border Classes="row" Classes.high="{Binding IsHigh}" Classes.low="{Binding IsLow}" Classes.closed="{Binding IsClosed}">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding FileName}" FontWeight="SemiBold"/>
                          <Run Text="  "/>
                          <Run Text="{Binding Title}" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
                        </TextBlock>
                        <Border Grid.Column="1" Classes="chip" Margin="0,0,6,0"><TextBlock Text="{Binding StatusText}"/></Border>
                        <TextBlock Grid.Column="2" Classes="dim" Text="{Binding ReceivedText}" VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Button Classes="flat small" Content="Commit'e git" Click="OnHistoryGoToCommit" IsVisible="{Binding CanGoToCommit}"/>
                        <Button Classes="flat small" Content="Geri getir" Click="OnHistoryRestore" IsVisible="{Binding CanRestore}"
                                ToolTip.Tip="Yoksayma kuralını kaldırır; risk hâlâ geçerliyse uyarıyı yeniden gösterir"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Grid.Row="1" Classes="flat small" HorizontalAlignment="Right" Margin="0,6,0,0"
                  Content="Geçmişi temizle" Click="OnClearHistory" IsVisible="{Binding HasHistory}"
                  ToolTip.Tip="Aktif olmayan kayıtları siler"/>
        </Grid>
      </TabItem>

      <!-- Ignore rules -->
      <TabItem>
        <TabItem.Header>
          <TextBlock Classes="tab_header" Text="Yoksayılanlar"/>
        </TabItem.Header>
        <Grid>
          <TextBlock Classes="dim" Margin="2,4" IsVisible="{Binding !HasIgnoreRules}"
                     Text="Yoksayma kuralı yok. Bir uyarıda 'Yoksay' dediğinde kural buraya eklenir; buradan kaldırabilirsin."/>
          <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasIgnoreRules}">
            <ItemsControl ItemsSource="{Binding IgnoreRules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="m:ConflictIgnoreRule">
                  <Border Classes="row low">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="1" Classes="flat small" Content="Kaldır" Click="OnRemoveIgnoreRule"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
