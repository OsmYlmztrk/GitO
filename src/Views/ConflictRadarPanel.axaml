<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:v="using:SourceGit.Views"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="400"
             x:Class="SourceGit.Views.ConflictRadarPanel"
             x:DataType="vm:ConflictRadar"
             Width="460">
  <UserControl.Styles>
    <Style Selector="Border.risk_row">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="3,1,1,1"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Window}"/>
      <Setter Property="BorderBrush" Value="#FFF0A33A"/>
    </Style>
    <Style Selector="Border.risk_row.high">
      <Setter Property="BorderBrush" Value="#FFE5534B"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="4">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
      <Path Grid.Column="0" Width="14" Height="14" Data="{StaticResource Icons.Conflict}" Fill="#FFF0A33A"/>
      <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="Çakışma Radarı" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
      <v:LoadingIcon Grid.Column="2" Width="14" Height="14" Margin="0,0,8,0" IsVisible="{Binding IsScanning}"/>
      <Button Grid.Column="3" Classes="flat" Height="24" Padding="8,0" Content="Yeniden tara" FontSize="11" Click="OnRescan"/>
    </Grid>

    <!-- Settings -->
    <Border Grid.Row="1" Padding="10,6" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource Brush.SubPanel}">
      <StackPanel Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <CheckBox Content="Açık" IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
        <CheckBox Content="Sesli uyarı" IsChecked="{Binding IsSoundEnabled, Mode=TwoWay}"/>
        <CheckBox IsChecked="{Binding IsAutoFetchEnabled, Mode=TwoWay}">
          <TextBlock>
            <Run Text="Otomatik fetch ("/><Run Text="{Binding AutoFetchInterval}"/><Run Text=" dk)"/>
          </TextBlock>
        </CheckBox>
      </StackPanel>
      <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FFE0B868" IsVisible="{Binding !IsAutoFetchEnabled}"
                 Text="Otomatik fetch kapalı: radar ekibin yeni push'larını ancak sen Fetch'e bastığında görür."/>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Son" VerticalAlignment="Center"/>
          <NumericUpDown Width="92" Height="26" Minimum="1" Maximum="90" Increment="1" FormatString="0"
                         Value="{Binding ActiveDays, Mode=TwoWay}"/>
          <TextBlock Text="gündeki branch'ler" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Risks -->
    <Grid Grid.Row="2">
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}" Margin="2,4"
                 IsVisible="{Binding !HasRisks}">
        <Run Text="Şu an çakışma riski yok. Değiştirdiğin dosyalar, son"/>
        <Run Text="{Binding ActiveDays}"/>
        <Run Text="günde commit almış remote branch'lerle karşılaştırılıyor. Yeni commit'leri görmek için fetch gerekir."/>
      </TextBlock>

      <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasRisks}">
        <ItemsControl ItemsSource="{Binding Risks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:ConflictRisk">
              <Border Classes="risk_row" Classes.high="{Binding IsHigh}">
                <StackPanel Spacing="3">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding FileName}" FontWeight="SemiBold"/>
                      <Run Text="  "/>
                      <Run Text="{Binding Folder}" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FFF0A33A" IsVisible="{Binding !IsHigh}"/>
                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FFE5534B" IsVisible="{Binding IsHigh}"/>
                  </Grid>
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding YourSide}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.FG2}"/>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                    <Button Classes="flat link" Content="Commit'e git" Click="OnGoToCommit"/>
                    <Button Classes="flat link" Content="Yoksay" Click="OnIgnore"
                            ToolTip.Tip="Bu dosya ve branch için bu oturumda tekrar uyarma"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
